# ── Alpaca PAPER trading credentials ─────────────────────────────────────────
# Get them at https://app.alpaca.markets → switch to your Paper account → API Keys.
# NEVER commit real keys. This platform refuses to run against a live account.
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_PAPER=true

# ── Anthropic API (LLM multi-agent sleeve) ───────────────────────────────────
# Optional: if unset, the LLM sleeve disables itself and the classical sleeves
# still run. Spend is hard-capped by QF_LLM_DAILY_BUDGET_USD.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional overrides (defaults shown) ──────────────────────────────────────
QF_LLM_MODEL=claude-opus-5
QF_LLM_DAILY_BUDGET_USD=5.00
QF_LLM_PER_RUN_BUDGET_USD=1.00
QF_DASHBOARD_PORT=8000
QF_STARTING_CASH=100000
QF_DATA_DIR=data

# Risk profile: conservative (default) | explosive (high-variance paper testing;
# wide limits, short-dated long-options convexity sleeve, 2-way book)
QF_RISK_PROFILE=conservative
